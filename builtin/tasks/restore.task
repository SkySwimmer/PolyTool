#!/bin/bash

function restore_define() {
    runRelativeToCallerProject=true
    allowMultiExecute=false
    runtimeTaskShared=true
}

function restore_run() {
    # Restore project
    local dirFriendly="${projectsDirFriendly["$LOCALPROJECTID"]}"

    # Restore dependency sheets
    for path in "$LOCALPROJECT/dependencies/"*.dep; do
        # Load dependency project if polyfile is present
        if [ -f "$path" ]; then
            # Load dependency sheet
            depFile="$(basename "$path")"
            depFilePretty="$dirFriendly/dependencies/$(basename "$path")"

            # Setup
            setupDependencyEnvironment "$path"

            # Load file
            source "$path" || loadDependencyError "$depFilePretty"

            # Load overload
            local localOverload="$LOCALPROJECT/polylocal/dependencies/$(basename "$path")"
            if [ -f "$localOverload" ]; then 
                source "$localOverload" || loadDependencyError "<local>/polylocal/dependencies/$(basename "$path")"
            fi

            # Check required fields
            if [ "$type" == "undefined" ]; then
                1>&2 echo "Error: dependency sheet $projectDir/dependencies/$path did not assign an 'type' field!"
                return 1
            fi
            if [ "$id" == "undefined" ]; then
                1>&2 echo "Error: dependency sheet $projectDir/dependencies/$path did not assign an 'id' field!"
                return 1
            fi
            if [ "$output" == "undefined" ]; then
                1>&2 echo "Error: dependency sheet $projectDir/dependencies/$path did not assign an 'output' field!"
                return 1
            fi
            echo ">> Restoring: $id"
            depOutput="$output"

            # Load type
            depType="$type"
            depTypeFound=false
            local baseProjectId="$BASEPROJECTID"
            local localProjectId="$LOCALPROJECTID"
            local rootProjectId="$ROOTPROJECTID"
            local exit=$?
            if [ "$exit" != 0 ]; then
                return $exit
            fi
            if [ "$depTypeFound" != "true" ]; then
                findAndSourceDepTypeFileFromProject "$localProjectId" "$type" 
                if [ "$baseProjectId" != "$localProjectId" ]; then
                    findAndSourceDepTypeFileFromProject "$baseProjectId" "$type"
                    local exit2=$?
                    if [ "$exit2" != 0 ]; then
                        return $exit2
                    fi
                    if [ "$depTypeFound" != "true" ]; then
                        if [ "$rootProjectId" != "$localProjectId" ]; then
                            findAndSourceDepTypeFileFromProject "$rootProjectId" "$type" 
                            local exit3=$?
                            if [ "$exit3" != 0 ]; then
                                return $exit3
                            fi
                        fi
                    fi
                fi
            fi

            # Check result
            if [ "$depTypeFound" != "true" ]; then
                # Fail

                # Error
                1>&2 echo "Error: unrecognized dependency type '$type' in dependency file $depFilePretty"

                # Clean type properties
                depType="undefined"

                # Clean
                cleanDependencyEnvironment "$path"
                return $exit
            fi

            # Call prepare
            if type "${depType}_deptype_define" &>/dev/null; then
                runFunctionSafe "${depType}_deptype_define"
                local exit=$?
                if [ "$exit" != 0 ]; then
                    # Clean type properties
                    depType="undefined"

                    # Clean
                    cleanDependencyEnvironment "$path"
                    return $exit
                fi
            fi

            # Setup
            setupDependencyEnvironment "$path"
            if type "${depType}_deptype_setupEnvironment" &>/dev/null; then
                runFunctionSafe "${depType}_deptype_setupEnvironment"
                local exit=$?
                if [ "$exit" != 0 ]; then
                    # Clean type properties
                    depType="undefined"

                    # Clean
                    cleanDependencyEnvironment "$path"
                    return $exit
                fi
            fi

            # Load file
            source "$path" || loadDependencyError "$depFilePretty"

            # Load overload
            local localOverload="$LOCALPROJECT/polylocal/dependencies/$(basename "$path")"
            if [ -f "$localOverload" ]; then 
                source "$localOverload" || loadDependencyError "<local>/polylocal/dependencies/$(basename "$path")"
            fi

            # Load setting
            local targetBaseProject="$baseproject"
            
            # Call verify
            runFunctionSafe "${depType}_deptype_syntaxVerify"
            local exit=$?
            if [ "$exit" != 0 ]; then
                # Error
                1>&2 echo "Error: syntax errors in dependency file $depFilePretty"

                # Call clean
                if type "${depType}_deptype_cleanEnvironment" &>/dev/null; then
                    runFunctionSafe "${depType}_deptype_cleanEnvironment"
                    local exit2=$?
                    if [ "$exit2" != 0 ]; then
                        # Clean type properties
                        depType="undefined"

                        # Clean
                        cleanDependencyEnvironment "$path"
                        return $exit2
                    fi
                fi

                # Clean type properties
                depType="undefined"

                # Clean
                cleanDependencyEnvironment "$path"
                return $exit
            fi

            # Call run
            local outputPath="$LOCALPROJECT/$depOutput"
            runFunctionSafe "${depType}_deptype_restore" "$ououtputPathtput"
            local exit=$?
            if [ "$exit" != 0 ]; then
                # Error
                1>&2 echo "Error: failed to restore dependency '$id', dependency file: $depFilePretty"

                # Call clean
                if type "${depType}_deptype_cleanEnvironment" &>/dev/null; then
                    runFunctionSafe "${depType}_deptype_cleanEnvironment"
                    local exit2=$?
                    if [ "$exit2" != 0 ]; then
                        # Clean type properties
                        depType="undefined"

                        # Clean
                        cleanDependencyEnvironment "$path"
                        return $exit2
                    fi
                fi

                # Clean type properties
                depType="undefined"

                # Clean
                cleanDependencyEnvironment "$path"
                return $exit
            fi

            # Call clean
            if type "${depType}_deptype_cleanEnvironment" &>/dev/null; then
                runFunctionSafe "${depType}_deptype_cleanEnvironment"
                local exit=$?
                if [ "$exit" != 0 ]; then
                    # Clean type properties
                    depType="undefined"

                    # Clean
                    cleanDependencyEnvironment "$path"
                    return $exit
                fi
            fi

            # Check result
            local path="$LOCALPROJECT/$depOutput"
            local dependencyId="$LOCALPROJECTID"
            if [ -d "$path" ] && ([ -f "$path/polyfile.pcb" ] || [ -f "$path/Polyfile.pcb" ]); then
                # Get set ID
                local setId="${projectsSetIds["$LOCALPROJECTID"]}"
                local projectDirPretty="${projectsDirFriendly["$LOCALPROJECTID"]}"

                # Get project environment
                local currentBaseProject="$BASEPROJECT"
                local currentBaseBuild="$BASEBUILDDIR"
                local currentBaseId="$BASEPROJECTID"
                local currentBaseVersion="$BASEPROJECTVERSION"
                local currentBaseGroup="$BASEPROJECTGROUP"
                local currentProjectId="$LOCALPROJECTID"
                local currentProjectBuild="$BUILDDIR"
                local currentProject="$LOCALPROJECT"
                local currentProjectVersion="$LOCALPROJECTVERSION"
                local currentProjectGroup="$LOCALPROJECTVERSION"
                local currentDependencyProjectPaths=("${dependencyProjectPaths[@]}")
                local currentSubProjectPaths=("${subProjectPaths[@]}")
                declare -A currentLocalProperties=()
                copyAssociativeArray LOCALPROPERTIES currentLocalProperties

                # Prepare paths
                local pathName="$(basename "$path")"
                local currentId="$LOCALPROJECTID"
                local pathpretty="$projectDirPretty/$depOutput"
                local fullpath="$(readlink -f "$path")"

                # Get current base
                local baseProject="$BASEPROJECT"
                local baseProjectId="$BASEPROJECTID"
                local baseProjectVersion="$BASEPROJECTVERSION"
                local baseProjectGroup="$BASEPROJECTGROUP"
                local baseBuild="$BASEBUILDDIR"

                # Update base project
                if [ "$targetBaseProject" == "dependency" ]; then
                    # Unset, dependencies each are treated as a base
                    BASEPROJECT=undefined
                    BASEPROJECTID=undefined
                    BASEBUILDDIR=undefined
                    BASEPROJECTVERSION=undefined
                    BASEPROJECTGROUP=undefined
                fi

                # Setup
                dependencyProjectPaths=()
                subProjectPaths=()
                local currentCwd="$PWD"
                cd "$fullpath"
                
                # Try loading it
                name="dependency $dependencyId"
                local restorefull="false"
                if [ "${PARAMETERS["sparse"]}" != true ]; then 
                    restorefull=true
                fi
                if ! loadProject "$pathpretty" "$fullpath" "dependency $dependencyId" "" "$restorefull" false false ">>> " ; then
                    1>&2 echo "Error: error loading dependency \"$dependencyId\": project could not be loaded"
                    return 1
                fi
                BASEPROJECT="$baseProject"
                BASEPROJECTID="$baseProjectId"
                BASEBUILDDIR="$baseBuild"
                BASEPROJECTVERSION="$baseProjectVersion"
                BASEPROJECTGROUP="$baseProjectGroup"
                local loadedId="$id"

                # Loaded successfully
                # Add project to list
                if ! arrayContains "$loadedId" "dependencies_$setId"; then
                    eval "dependencies_$setId"'+=("'"$loadedId"'")'
                fi

                # Restore dependencies
                if [ "${PARAMETERS["sparse"]}" != true ]; then 
                    if ! arrayContains "$fullpath" ANTIRECURSIONLIST; then
                        local recLAST="$RESTORERECURSING"
                        RESTORERECURSING=true
                        local callTaskListLast=("${ANTIRECURSIONLIST[@]}")
                        ANTIRECURSIONLIST=()
                        ANTIRECURSIONLIST+=("${callTaskListLast[@]}")
                        ANTIRECURSIONLIST+=("$fullpath")
                        runLocalToProject "$loadedId" environmentPrepareProjectTasks "restore" "$loadedId" "$LOCALPROJECT"
                        runLocalToProject "$loadedId" tasksDependenciesExecPre "restore" false "$loadedId" "$LOCALPROJECT" | sed "s/^/>>> /g" | sed "s/^>>> >>>/>>>>>/g" | sed "s/^>>> >>/>>>/g" | sed "s/^>>> >/>>>/g"
                        restore_run | sed "s/^/>>> /g" | sed "s/^>>> >>>/>>>>>/g" | sed "s/^>>> >>/>>>/g" | sed "s/^>>> >/>>>/g"
                        runLocalToProject "$loadedId" tasksDependenciesExecPost "restore" false "$loadedId" "$LOCALPROJECT" | sed "s/^/>>> /g" | sed "s/^>>> >>>/>>>>>/g" | sed "s/^>>> >>/>>>/g" | sed "s/^>>> >/>>>/g"
                        RESTORERECURSING="$recLAST"
                        ANTIRECURSIONLIST=("${callTaskListLast[@]}")    
                    fi
                fi

                # Restore environment
                cd "$currentCwd"
                BASEPROJECT="$currentBaseProject"
                BASEBUILDDIR="$currentBaseBuild"
                BASEPROJECTID="$currentBaseId"
                BASEPROJECTVERSION="$currentBaseVersion"
                BASEPROJECTGROUP="$currentBaseGroup"
                LOCALPROJECTID="$currentProjectId"
                LOCALPROJECTVERSION="$currentProjectVersion"
                LOCALPROJECTGROUP="$currentProjectGroup"
                BUILDDIR="$currentProjectBuild"
                LOCALPROJECT="$currentProject"
                dependencyProjectPaths=("${currentDependencyProjectPaths[@]}")
                subProjectPaths=("${currentSubProjectPaths[@]}")
                LOCALPROPERTIES=()
                copyAssociativeArray currentLocalProperties LOCALPROPERTIES
            fi
            
            # Clean type properties
            depType="undefined"

            # Clean
            cleanDependencyEnvironment "$path"
        fi
    done

    # Then restore defined dependencies, which might be created only after restoring
    for depOutput in "${dependencyProjectPaths[@]}"; do
        if [ "$depOutput" == "" ]; then 
            continue
        fi 

        # Check output
        local path="$LOCALPROJECT/$depOutput"
        if [ -d "$path" ] && ([ -f "$path/polyfile.pcb" ] || [ -f "$path/Polyfile.pcb" ]); then
            echo ">> Restoring: $(basename "$path")"

            # Get set ID
            local setId="${projectsSetIds["$LOCALPROJECTID"]}"
            local projectDirPretty="${projectsDirFriendly["$LOCALPROJECTID"]}"

            # Get project environment
            local currentBaseProject="$BASEPROJECT"
            local currentBaseBuild="$BASEBUILDDIR"
            local currentBaseId="$BASEPROJECTID"
            local currentBaseVersion="$BASEPROJECTVERSION"
            local currentBaseGroup="$BASEPROJECTGROUP"
            local currentProjectId="$LOCALPROJECTID"
            local currentProjectBuild="$BUILDDIR"
            local currentProject="$LOCALPROJECT"
            local currentProjectVersion="$LOCALPROJECTVERSION"
            local currentProjectGroup="$LOCALPROJECTVERSION"
            declare -A currentLocalProperties=()
            copyAssociativeArray LOCALPROPERTIES currentLocalProperties
            local currentDependencyProjectPaths=("${dependencyProjectPaths[@]}")
            local currentSubProjectPaths=("${subProjectPaths[@]}")

            # Prepare paths
            local pathName="$(basename "$path")"
            local currentId="$LOCALPROJECTID"
            local pathpretty="$projectDirPretty/$depOutput"
            local fullpath="$(readlink -f "$path")"

            # Get current base
            local baseProject="$BASEPROJECT"
            local baseProjectId="$BASEPROJECTID"
            local baseProjectVersion="$BASEPROJECTVERSION"
            local baseProjectGroup="$BASEPROJECTGROUP"
            local baseBuild="$BASEBUILDDIR"

            # Unset, dependencies each are treated as a base
            BASEPROJECT=undefined
            BASEPROJECTID=undefined
            BASEBUILDDIR=undefined
            BASEPROJECTVERSION=undefined
            BASEPROJECTGROUP=undefined
            dependencyProjectPaths=()
            subProjectPaths=()
            local currentCwd="$PWD"
            cd "$fullpath"
            
            # Try loading it
            name="dependency $pathName"
            local restorefull="false"
            if [ "${PARAMETERS["sparse"]}" != true ]; then 
                restorefull=true
            fi
            if ! loadProject "$pathpretty" "$fullpath" "dependency $pathName" "" "$restorefull" false false ">>> " ; then
                1>&2 echo "Error: error loading dependency \"$pathName\": project could not be loaded"
                return 1
            fi
            BASEPROJECT="$baseProject"
            BASEPROJECTID="$baseProjectId"
            BASEBUILDDIR="$baseBuild"
            BASEPROJECTVERSION="$baseProjectVersion"
            BASEPROJECTGROUP="$baseProjectGroup"
            local loadedId="$id"

            # Loaded successfully
            # Add project to list
            if ! arrayContains "$loadedId" "dependencies_$setId"; then
                eval "dependencies_$setId"'+=("'"$loadedId"'")'
            fi

            # Restore dependencies
            if [ "${PARAMETERS["sparse"]}" != true ]; then 
                if ! arrayContains "$fullpath" ANTIRECURSIONLIST; then
                    local recLAST="$RESTORERECURSING"
                    RESTORERECURSING=true
                    local callTaskListLast=("${ANTIRECURSIONLIST[@]}")
                    ANTIRECURSIONLIST=()
                    ANTIRECURSIONLIST+=("${callTaskListLast[@]}")
                    ANTIRECURSIONLIST+=("$fullpath")
                    runLocalToProject "$loadedId" environmentPrepareProjectTasks "restore" "$loadedId" "$LOCALPROJECT"
                    runLocalToProject "$loadedId" tasksDependenciesExecPre "restore" false "$loadedId" "$LOCALPROJECT" | sed "s/^/>>> /g" | sed "s/^>>> >>>/>>>>>/g" | sed "s/^>>> >>/>>>/g" | sed "s/^>>> >/>>>/g"
                    restore_run | sed "s/^/>>> /g" | sed "s/^>>> >>>/>>>>>/g" | sed "s/^>>> >>/>>>/g" | sed "s/^>>> >/>>>/g"
                    runLocalToProject "$loadedId" tasksDependenciesExecPost "restore" false "$loadedId" "$LOCALPROJECT" | sed "s/^/>>> /g" | sed "s/^>>> >>>/>>>>>/g" | sed "s/^>>> >>/>>>/g" | sed "s/^>>> >/>>>/g"
                    RESTORERECURSING="$recLAST"
                    ANTIRECURSIONLIST=("${callTaskListLast[@]}")    
                fi
            fi

            # Restore environment
            cd "$currentCwd"
            BASEPROJECT="$currentBaseProject"
            BASEBUILDDIR="$currentBaseBuild"
            BASEPROJECTID="$currentBaseId"
            BASEPROJECTVERSION="$currentBaseVersion"
            BASEPROJECTGROUP="$currentBaseGroup"
            LOCALPROJECTID="$currentProjectId"
            LOCALPROJECTVERSION="$currentProjectVersion"
            LOCALPROJECTGROUP="$currentProjectGroup"
            BUILDDIR="$currentProjectBuild"
            LOCALPROJECT="$currentProject"
            LOCALPROPERTIES=()
            copyAssociativeArray currentLocalProperties LOCALPROPERTIES
            dependencyProjectPaths=("${currentDependencyProjectPaths[@]}")
            subProjectPaths=("${currentSubProjectPaths[@]}")
        fi
    done

    # Then restore subprojects, which might be created only after restoring
    for subProjectPath in "${subProjectPaths[@]}"; do
        if [ "$subProjectPath" == "" ]; then 
            continue
        fi 

        # Check output
        local path="$LOCALPROJECT/$subProjectPath"
        if [ -d "$path" ] && ([ -f "$path/polyfile.pcb" ] || [ -f "$path/Polyfile.pcb" ]); then
            echo ">> Restoring: $(basename "$path")"

            # Get set ID
            local setId="${projectsSetIds["$LOCALPROJECTID"]}"
            local projectDirPretty="${projectsDirFriendly["$LOCALPROJECTID"]}"

            # Get project environment
            local currentBaseProject="$BASEPROJECT"
            local currentBaseBuild="$BASEBUILDDIR"
            local currentBaseId="$BASEPROJECTID"
            local currentBaseVersion="$BASEPROJECTVERSION"
            local currentBaseGroup="$BASEPROJECTGROUP"
            local currentProjectId="$LOCALPROJECTID"
            local currentProjectBuild="$BUILDDIR"
            local currentProject="$LOCALPROJECT"
            local currentProjectVersion="$LOCALPROJECTVERSION"
            local currentProjectGroup="$LOCALPROJECTVERSION"
            declare -A currentLocalProperties=()
            copyAssociativeArray LOCALPROPERTIES currentLocalProperties
            local currentDependencyProjectPaths=("${dependencyProjectPaths[@]}")
            local currentSubProjectPaths=("${subProjectPaths[@]}")

            # Prepare paths
            local pathName="$(basename "$path")"
            local currentId="$LOCALPROJECTID"
            local pathpretty="$projectDirPretty/$subProjectPath"
            local fullpath="$(readlink -f "$path")"

            # Get current base
            local baseProject="$BASEPROJECT"
            local baseProjectId="$BASEPROJECTID"
            local baseProjectVersion="$BASEPROJECTVERSION"
            local baseProjectGroup="$BASEPROJECTGROUP"
            local baseBuild="$BASEBUILDDIR"

            # Unset
            dependencyProjectPaths=()
            subProjectPaths=()
            local currentCwd="$PWD"
            cd "$fullpath"
            
            # Try loading it
            name="subproject $pathName"
            local restorefull="false"
            if [ "${PARAMETERS["sparse"]}" != true ]; then 
                restorefull=true
            fi
            if ! loadProject "$pathpretty" "$fullpath" "subproject $pathName" "" "$restorefull" false false ">>> " ; then
                1>&2 echo "Error: error loading subproject \"$pathName\": project could not be loaded"
                return 1
            fi
            local loadedId="$id"

            # Loaded successfully
            # Add project to list
            if ! arrayContains "$loadedId" "dependencies_$setId"; then
                eval "dependencies_$setId"'+=("'"$loadedId"'")'
            fi

            # Restore dependencies
            if [ "${PARAMETERS["sparse"]}" != true ]; then 
                if ! arrayContains "$fullpath" ANTIRECURSIONLIST; then
                    local recLAST="$RESTORERECURSING"
                    RESTORERECURSING=true
                    local callTaskListLast=("${ANTIRECURSIONLIST[@]}")
                    ANTIRECURSIONLIST=()
                    ANTIRECURSIONLIST+=("${callTaskListLast[@]}")
                    ANTIRECURSIONLIST+=("$fullpath")
                    runLocalToProject "$loadedId" environmentPrepareProjectTasks "restore" "$loadedId" "$LOCALPROJECT"
                    runLocalToProject "$loadedId" tasksDependenciesExecPre "restore" false "$loadedId" "$LOCALPROJECT" | sed "s/^/>>> /g" | sed "s/^>>> >>>/>>>>>/g"  | sed "s/^>>> >>/>>>/g" | sed "s/^>>> >/>>>/g"
                    restore_run | sed "s/^/>>> /g" | sed "s/^>>> >>>/>>>>>/g"  | sed "s/^>>> >>/>>>/g" | sed "s/^>>> >/>>>/g"
                    runLocalToProject "$loadedId" tasksDependenciesExecPost "restore" false "$loadedId" "$LOCALPROJECT" | sed "s/^/>>> /g" | sed "s/^>>> >>>/>>>>>/g"  | sed "s/^>>> >>/>>>/g" | sed "s/^>>> >/>>>/g"
                    RESTORERECURSING="$recLAST"
                    ANTIRECURSIONLIST=("${callTaskListLast[@]}")    
                fi
            fi

            # Restore environment
            cd "$currentCwd"
            BASEPROJECT="$currentBaseProject"
            BASEBUILDDIR="$currentBaseBuild"
            BASEPROJECTID="$currentBaseId"
            BASEPROJECTVERSION="$currentBaseVersion"
            BASEPROJECTGROUP="$currentBaseGroup"
            LOCALPROJECTID="$currentProjectId"
            LOCALPROJECTVERSION="$currentProjectVersion"
            LOCALPROJECTGROUP="$currentProjectGroup"
            BUILDDIR="$currentProjectBuild"
            LOCALPROJECT="$currentProject"
            LOCALPROPERTIES=()
            copyAssociativeArray currentLocalProperties LOCALPROPERTIES
            dependencyProjectPaths=("${currentDependencyProjectPaths[@]}")
            subProjectPaths=("${currentSubProjectPaths[@]}")
        fi
    done
    
    # Reload projects
    if [ "$RESTORERECURSING" != "true" ]; then
        echo ">> Reloading projects..."

        # Reset entire environment
        local lPWD="$PWD"
        cd "$ROOTPROJECT"
        ROOTPROJECT=undefined
        ROOTPROJECTVERSION=undefined
        ROOTPROJECTGROUP=undefined
        BASEPROJECT=undefined
        BASEPROJECTVERSION=undefined
        BASEPROJECTGROUP=undefined
        LOCALPROJECT=undefined
        LOCALPROJECTVERSION=undefined
        LOCALPROJECTGROUP=undefined
        ROOTPROJECTID=undefined
        BASEPROJECTID=undefined
        LOCALPROJECTID=undefined
        ROOTBUILDDIR=undefined
        BASEBUILDDIR=undefined
        BUILDDIR=undefined
        projects=()
        projectsNames=()
        projectsGroups=()
        projectsVersions=()
        projectsBaseProject=()
        projectsDirFriendly=()
        projectsByDir=()
        projectsByGroupAndId=()
        projectsSetIds=()
        projectsBaseProjectIds=()
        setIds=()
        LOCALPROPERTIES=()
        PROJECTMEMORYREFSCANNER_INIT=()
        TASKMEMORYREFSCANNER_INIT=()
        PROJECTMEMORYREFSCANNER_POPULATE=()
        TASKMEMORYREFSCANNER_POPULATE=()
        PROJECTMEMORYREFSCANNER_SCANNER=()
        TASKMEMORYREFSCANNER_SCANNER=()

        # Load projects
        if ! loadProject "<root>" "$PWD" "<root project>" "" false false false ">>> " ; then
            if [ ! -f "$PWD/polyfile.pcb" ] && [ ! -f "$PWD/Polyfile.pcb" ]; then
                1>&2 echo "Error: cannot proceed, please make sure the polyfile exists prior to running polytool"
            else
                1>&2 echo "Error: cannot proceed, root project could not be loaded"
            fi
            exit 1
        fi
        ROOTPROJECTID="$id"
        ROOTPROJECTNAME="$name"
        ROOTPROJECTVERSION="$version"
        if ! runLocalToProject "$ROOTPROJECTID" loadProjectDependencies false false false ">>> " ; then
            if [ ! -f "$PWD/polyfile.pcb" ] && [ ! -f "$PWD/Polyfile.pcb" ]; then
                1>&2 echo "Error: cannot proceed, please make sure the polyfile exists prior to running polytool"
            else
                1>&2 echo "Error: cannot proceed, root project could not be loaded"
            fi
            exit 1
        fi
        if ! runLocalToProject "$ROOTPROJECTID" loadProjectDependencies true false false ">>> " ; then
            if [ ! -f "$PWD/polyfile.pcb" ] && [ ! -f "$PWD/Polyfile.pcb" ]; then
                1>&2 echo "Error: cannot proceed, please make sure the polyfile exists prior to running polytool"
            else
                1>&2 echo "Error: cannot proceed, root project could not be loaded"
            fi
            exit 1
        fi
        cd "$lPWD"
        echo ">> Tasks will be reloaded, this can take a bit..."
        runLocalToProject "$ROOTPROJECTID" environmentPrepareProjectTasks "restore" "$ROOTPROJECTID" "$ROOTPROJECT"
        echo ">> Restore finished."
    fi
}

function findAndSourceDepTypeFileFromProject() {
    local projectId="$1"
    local projectDir="${projects["$projectId"]}"
    local depTypeName="$2"

    if [ "$depTypeFound" == "true" ]; then
        # Success
        return 0
    fi
    
    # Box recursion list
    # We basically copy the list, making it stack-sensitive
    # After this method finishes, we reset to what it was last
    # That way, cyclic calls are ignored without breaking other task files calling callTask for the same task
    local callTaskListLast=("${ANTIRECURSIONLIST[@]}")
    ANTIRECURSIONLIST=()
    ANTIRECURSIONLIST+=("${callTaskListLast[@]}")

    # Get list ID
    local setId="${projectsSetIds["$projectId"]}"

    # Find type locally
    execFindAndSourceDepTypeFile "$depTypeName" "$projectDir/deptypes" true "$projectId" "$projectDir"
    local exit=$?
    if [ "$exit" != 0 ]; then
        # Revert list
        ANTIRECURSIONLIST=("${callTaskListLast[@]}")
        return $exit
    fi
    if [ "$depTypeFound" == "true" ]; then
        # Success
        
        # Revert list
        ANTIRECURSIONLIST=("${callTaskListLast[@]}")
        return $exit
    fi

    # Go through sub projects recursively
    # We stay relative to the current project
    eval 'subprojectsList=("${'"subprojects_$setId"'[@]}")'
    for subProjectId in "${subprojectsList[@]}"; do
        local subProjectDir="${projects["$subProjectId"]}"

        # Run in subproject
        runLocalToProject "$subProjectId" findAndSourceDepTypeFileFromProject "$subProjectId" "$depTypeName"
        local exit=$?
        if [ "$exit" != 0 ]; then
            # Revert list
            ANTIRECURSIONLIST=("${callTaskListLast[@]}")
            return $exit
        fi
        if [ "$depTypeFound" == "true" ]; then
            # Success
            
            # Revert list
            ANTIRECURSIONLIST=("${callTaskListLast[@]}")
            return $exit
        fi
    done

    # Go through dependencies recursively
    # We stay relative to the current project
    eval 'dependenciesList=("${'"dependencies_$setId"'[@]}")'
    for depId in "${dependenciesList[@]}"; do
        local depDir="${projects["$depId"]}"

        # Run in dependency
        runLocalToProject "$depId" findAndSourceDepTypeFileFromProject "$depId" "$depTypeName"
        local exit=$?
        if [ "$exit" != 0 ]; then
            # Revert list
            ANTIRECURSIONLIST=("${callTaskListLast[@]}")
            return $exit
        fi
        if [ "$depTypeFound" == "true" ]; then
            # Success
            
            # Revert list
            ANTIRECURSIONLIST=("${callTaskListLast[@]}")
            return $exit
        fi
    done

    # Try finding it in the runtime
    local runtimeDepTypeDir="$RUNTIMEPATH/builtin/deptypes"
    if [ -d "$runtimeDepTypeDir" ]; then
        # Check state

        # Box again
        local callTaskListLast2=("${ANTIRECURSIONLIST[@]}")
        ANTIRECURSIONLIST=()
        ANTIRECURSIONLIST+=("${callTaskListLast2[@]}")

        # Find task
        runLocalToProject "$projectId" execFindAndSourceDepTypeFile "$depTypeName" "$runtimeDepTypeDir" false "" ""
        local exit=$?

        # Revert
        ANTIRECURSIONLIST=("${callTaskListLast2[@]}")

        # Handle exit
        if [ "$exit" != 0 ]; then
            # Revert list
            ANTIRECURSIONLIST=("${callTaskListLast[@]}")
            return $exit
        fi
        if [ "$depTypeFound" == "true" ]; then
            # Success
            
            # Revert list
            ANTIRECURSIONLIST=("${callTaskListLast[@]}")
            return $exit
        fi
    fi

    # Revert list
    ANTIRECURSIONLIST=("${callTaskListLast[@]}")
}

function execFindAndSourceDepTypeFile() {
    # Parse command
    local depTypeName="$1"
    local depTypesDir="$2"
    local isProject="$3" # if false, its a runtime task
    local projectId="$4"
    local projectDir="$5"

    # Find task
    if [ -d "$depTypesDir" ]; then
        # Try to find task
        if [ -f "$depTypesDir/$depTypeName.deptype" ]; then
            # Found task
            depTypeFound=true

            # Check recursion
            if arrayContains "$depTypesDir/$depTypeName.deptype" ANTIRECURSIONLIST; then
                return 0
            fi
            ANTIRECURSIONLIST+=("$depTypesDir/$depTypeName.deptype")
            
            local depTypeFile="$depTypesDir/$depTypeName.deptype"
            local localDepTypeFile="$LOCALPROJECT/polylocal/deptypes/$depTypeName.deptype"
            source "$depTypeFile" || depTypeLoadError "$depTypeName.deptype"
            if [ -f "$localDepTypeFile" ]; then
                source "$localDepTypeFile" || depTypeLoadError "${projectsDirFriendly["$LOCALPROJECTID"]}/polylocal/deptypes/$depTypeName.deptype"
            fi
        fi
    fi
}
